{
  "name": "novel-platform",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n WEB,API,ADMIN -c blue,green,magenta \"bun run web\" \"bun run api\" \"bun run admin\"",
    "api": "bun run --cwd apps/api dev",
    "web": "bun run --cwd apps/web dev",
    "admin": "bun run --cwd apps/admin dev",
    "tts": "cd apps/tts-agent && ./.venv/Scripts/python.exe scripts/watch_tts.py"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
